    {
      "parameters": {
        "jsCode": "console.log(JSON.stringify(items[0].json))\nconst rawData = $input.first().json.data;\n\n// Strip XML tags and clean up whitespace\nconst cleanText = rawData\n  .replace(/<[^>]*>/g, ' ')\n  .replace(/&amp;/g, '&')\n  .replace(/&lt;/g, '<')\n  .replace(/&gt;/g, '>')\n  .replace(/&quot;/g, '\"')\n  .replace(/&#39;/g, \"'\")\n  .replace(/\\s+/g, ' ')\n  .trim();\n\n// Truncate to 6000 characters to stay within token limits\nconst truncated = cleanText.substring(0, 6000);\n\nreturn [{\n  json: {\n    document_number: $input.first().json.document_number || '',\n    title: $input.first().json.title || '',\n    publication_date: $input.first().json.publication_date || '',\n    html_url: $input.first().json.html_url || '',\n    clean_text: truncated\n  }\n}];"
