      "parameters": {
        "jsCode": "const items = $input.all();\nconst item = items[0].json;\n\nlet impactReport = '';\n\ntry {\n  const langflowBody = Array.isArray(item) ? item : [item];\n  impactReport = langflowBody[0].outputs[0].outputs[1].results.message.text;\n} catch(e) {\n  impactReport = 'Parse error: ' + e.message;\n}\n\n// Convert markdown to Slack mrkdwn format AFTER fetching\nimpactReport = impactReport\n  .replace(/## /g, '*')\n  .replace(/### /g, '\\n*')\n  .replace(/\\*\\*(.*?)\\*\\*/g, '*$1*')\n  .replace(/---/g, '─────────────────────');\n\nreturn [{ \n  json: {\n    document_number: item.document_number || '',\n    title: item.title || '',\n    publication_date: item.publication_date || '',\n    html_url: item.html_url || '',\n    impact_report: impactReport,\n    processed_at: new Date().toISOString()\n  }\n}];"
