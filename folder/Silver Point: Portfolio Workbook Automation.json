    {
      "parameters": {
        "jsCode": "function getPrevBusinessDay(date, offset) {\n  let d = new Date(date);\n  let count = 0;\n  while (count < offset) {\n    d.setDate(d.getDate() - 1);\n    if (d.getDay() !== 0 && d.getDay() !== 6) count++;\n  }\n  return d.toISOString().slice(0, 10).replace(/-/g, '');\n}\nconst today = new Date();\nreturn [{ json: {\n  todayStr: today.toISOString().slice(0,10).replace(/-/g,''),\n  prevBizDay: getPrevBusinessDay(today, 1),    // e.g. '20250307'\n  twoBizDaysBack: getPrevBusinessDay(today, 2) // e.g. '20250306'\n}}];\n\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
