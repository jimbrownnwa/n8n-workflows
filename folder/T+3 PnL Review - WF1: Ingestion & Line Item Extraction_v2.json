    {
      "parameters": {
        "jsCode": "// Normalize all sheet items into a consistent tracker record format\n// The column names vary across sheets, so we handle each pattern\n\nconst items = $input.all();\nconst trackerRecords = [];\nconst now = new Date().toISOString();\n\nfor (const item of items) {\n  const d = item.json;\n  const sheet = d.sourceSheet || 'Unknown';\n  \n  // Skip header/subtotal rows (CASE_1, CASE_2, etc.) and blank security rows\n  const security = d['Thinly Traded Quoted Security'] \n    || d['IssuerGroup/Strategy/Security'] \n    || d['(Underlier) Security']\n    || d['Strategy --> Sycode']\n    || d['IssuerGroup/Security']\n    || '';\n  \n  if (!security || security.match(/^CASE_\\d/) || security.match(/^Winners|^Losers/i)) {\n    continue;\n  }\n  \n  // Extract analyst from column 0 or the Analyst(s) column\n  // Sheet1 col0 has senior analyst, col23 has detailed assignment\n  // Sheet4 col0 has senior analyst\n  const seniorAnalyst = d['column_0'] || d[''] || '';\n  const analystAssignment = d['Analyst(s)'] || '';\n  \n  // Parse the analyst assignment format: \"TMONTAGUE;jjeffrey\"\n  let primaryAnalyst = '';\n  let supportingAnalysts = [];\n  \n  if (analystAssignment) {\n    const parts = analystAssignment.split(';');\n    primaryAnalyst = (parts[0] || '').trim().toUpperCase();\n    if (parts[1]) {\n      supportingAnalysts = parts[1].split(',').map(a => a.trim()).filter(Boolean);\n    }\n  } else if (seniorAnalyst && seniorAnalyst.length < 30) {\n    primaryAnalyst = seniorAnalyst.trim().toUpperCase();\n  }\n  \n  // Skip if no analyst assignment (likely a group header row)\n  if (!primaryAnalyst) continue;\n  \n  // Extract issuer group where available\n  const issuerGroup = d['Issuer Group'] || d['IssuerGroup'] || '';\n  \n  // Extract key financial data\n  const closingPx = d['Closing Px'] || d['Local Closing Px'] || '';\n  const openingPx = d['Opening Px'] || d['Local Opening Px'] || '';\n  const pxPctChg = d['Px Pct Chg'] || d['Adj. Px Pct Chg'] || '';\n  const marketValue = d['Market Value'] || d['Functional MarketValue'] || '';\n  const pnl = d['PnL ExFx'] || d['Trading PnL'] || d['Local\\nTotal PnL\\nExFx¹'] || d['Total PnL'] || '';\n  \n  trackerRecords.push({\n    // Identification\n    security: security.trim(),\n    issuerGroup: issuerGroup.trim(),\n    sourceSheet: sheet,\n    sheetDescription: d.sheetDescription || '',\n    \n    // Analyst assignment\n    primaryAnalyst: primaryAnalyst,\n    supportingAnalysts: supportingAnalysts,\n    analystRaw: analystAssignment || seniorAnalyst,\n    \n    // Key financial data for context\n    closingPx: closingPx,\n    openingPx: openingPx,\n    pxPctChg: pxPctChg,\n    marketValue: marketValue,\n    pnl: pnl,\n    \n    // Tracking fields (will be updated by WF2)\n    status: 'PENDING',\n    confirmedBy: '',\n    confirmedAt: '',\n    confirmationEmailId: '',\n    flagged: false,\n    flagReason: '',\n    notes: '',\n    \n    // Metadata\n    createdAt: now,\n    lastUpdated: now\n  });\n}\n\n// Sort by analyst then sheet for clean output\ntrackerRecords.sort((a, b) => {\n  if (a.primaryAnalyst !== b.primaryAnalyst) return a.primaryAnalyst.localeCompare(b.primaryAnalyst);\n  return a.sourceSheet.localeCompare(b.sourceSheet);\n});\n\nreturn trackerRecords.map(r => ({ json: r }));"
      },
      "id": "normalize_1",
      "name": "Normalize & Build Tracker Records",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1344,
        496
      ]
    },
    {
      "parameters": {
        "jsCode": "// Generate a summary of what was ingested for logging/audit\nconst items = $input.all();\n\n// Count by analyst\nconst byAnalyst = {};\nconst bySheet = {};\n\nfor (const item of items) {\n  const analyst = item.json.primaryAnalyst;\n  const sheet = item.json.sourceSheet;\n  \n  byAnalyst[analyst] = (byAnalyst[analyst] || 0) + 1;\n  bySheet[sheet] = (bySheet[sheet] || 0) + 1;\n}\n\nconst summary = {\n  totalLineItems: items.length,\n  uniqueAnalysts: Object.keys(byAnalyst).length,\n  itemsByAnalyst: byAnalyst,\n  itemsBySheet: bySheet,\n  ingestedAt: new Date().toISOString(),\n  status: 'INGESTION_COMPLETE'\n};\n\n// Return summary as first item, then all tracker records\nreturn [{ json: summary }, ...items];"
      },
      "id": "summary_1",
      "name": "Generate Ingestion Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1744,
        496
      ]
    },
    {
      "parameters": {
        "content": "## T+3 PnL Review - Workflow 1: Ingestion\n\n**Purpose:** Ingest the monthly PRICE_CHANGE_ALL XLS attachment from the pricechange@ mailbox, parse Sheets 1-4, extract analyst-to-security line items, and build the tracking records that Workflows 2 (response listener) and 3 (summary/follow-up) operate against.\n\n**Trigger:** Fires when a new email with attachment arrives matching the P&L Review subject pattern.\n\n**Output:** Normalized tracker records with status=PENDING for each security line item requiring analyst sign-off.",
        "height": 360,
        "width": 400
      },
