    {
      "parameters": {
        "jsCode": "function parseMonthYear(value) {\n  if (!value) return null;\n\n  const startPart = value.split(' - ')[0].trim();\n  const parts = startPart.split(' ');\n  if (parts.length !== 2) return null;\n\n  const monthMap = {\n    jan: 0, feb: 1, mar: 2, apr: 3, may: 4, jun: 5,\n    jul: 6, aug: 7, sep: 8, oct: 9, nov: 10, dec: 11\n  };\n\n  const month = monthMap[parts[0].toLowerCase()];\n  const year = parseInt(parts[1], 10);\n\n  if (month === undefined || isNaN(year)) return null;\n\n  return new Date(year, month, 1);\n}\n\nfunction getDateBucket(startDate) {\n  if (!startDate) return '';\n\n  const today = new Date();\n  const diffMs = today - startDate;\n  const diffDays = Math.floor(diffMs / (1000 * 60 * 60 * 24));\n\n  if (diffDays < 90) return '<90 days';\n  if (diffDays <= 180) return '90-180 days';\n  return '>180 days';\n}\n\nreturn items.map((item, i) => {\n  const raw = item.json.linkedinJobDateRange || '';\n  const startDate = parseMonthYear(raw);\n  const bucket = getDateBucket(startDate);\n\n  return {\n    json: {\n      ...item.json,\n      normalized_job_start: startDate\n        ? startDate.toISOString().split('T')[0]\n        : '',\n      job_age_bucket: bucket\n    },\n    pairedItem: { item: i }\n  };\n});"
      },
