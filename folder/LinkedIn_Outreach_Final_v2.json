    {
      "parameters": {
        "jsCode": "function clean(value) {\n  return (value || '')\n    .toLowerCase()\n    .normalize('NFD')\n    .replace(/[\\u0300-\\u036f]/g, '')\n    .replace(/[^a-z]/g, '');\n}\n\nreturn items.map((item, i) => {\n  const first   = clean(item.json.first_name_clean || item.json.firstName || '');\n  const last    = clean(item.json.last_name_clean  || item.json.lastName  || '');\n  // domain: prefer company_domain (Path 1 / no-URL) then clean_domain (Path 2 / has-URL)\n  const domain  = item.json.company_domain || item.json.clean_domain || item.json.domain || '';\n  const pattern = item.json.pattern || '{first}.{last}';\n\n  const localPart = pattern\n    .replace('{first}', first)\n    .replace('{last}',  last)\n    .replace('{f}',     first.charAt(0))\n    .replace('{l}',     last.charAt(0));\n\n  return {\n    json: {\n      ...item.json,\n      predicted_email: localPart && domain ? `${localPart}@${domain}` : ''\n    },\n    pairedItem: { item: i }\n  };\n});"
      },
