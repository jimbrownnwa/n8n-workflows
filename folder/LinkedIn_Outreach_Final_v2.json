    {
      "parameters": {
        "jsCode": "function cleanText(value, fieldName = 'unknown', rowNumber = 'unknown') {\n  if (value === null || value === undefined) return '';\n\n  if (typeof value !== 'string') {\n    console.log(`Non-string value detected | row: ${rowNumber} | field: ${fieldName} | type: ${typeof value} | value: ${JSON.stringify(value)}`);\n    return String(value).trim();\n  }\n\n  return value.trim();\n}\n\nfunction extractDomain(url, rowNumber = 'unknown') {\n  const cleanedUrl = cleanText(url, 'companyWebsite/companyURL', rowNumber);\n  if (!cleanedUrl) return '';\n\n  return cleanedUrl\n    .toLowerCase()\n    .replace(/^https?:\\/\\//, '')\n    .replace(/^www\\./, '')\n    .split('/')[0]\n    .split('?')[0]\n    .trim();\n}\n\nreturn items.map((item, i) => {\n  const rowNumber = item.json.rowNumber || item.json.row_number || item.json.Row || i + 1;\n\n  const nonStringFields = [];\n\n  function trackField(value, fieldName) {\n    if (value !== null && value !== undefined && typeof value !== 'string') {\n      nonStringFields.push({\n        field: fieldName,\n        type: typeof value,\n        value: value\n      });\n    }\n    return cleanText(value, fieldName, rowNumber);\n  }\n\n  const first = trackField(item.json.firstName, 'firstName');\n  const last = trackField(item.json.lastName, 'lastName');\n  const company = trackField(item.json.companyName, 'companyName');\n\n  const companyWebsiteRaw =\n    item.json.companyWebsite ??\n    item.json.companyURL ??\n    '';\n\n  if (companyWebsiteRaw !== null && companyWebsiteRaw !== undefined && typeof companyWebsiteRaw !== 'string') {\n    nonStringFields.push({\n      field: 'companyWebsite/companyURL',\n      type: typeof companyWebsiteRaw,\n      value: companyWebsiteRaw\n    });\n  }\n\n  const cleanDomain = extractDomain(companyWebsiteRaw, rowNumber);\n\n  return {\n    json: {\n      ...item.json,\n      first_name_clean: first,\n      last_name_clean: last,\n      full_name_clean: `${first} ${last}`.trim(),\n      company_name_clean: company,\n      clean_domain: cleanDomain,\n      status: nonStringFields.length ? 'normalized_with_warnings' : 'normalized',\n      normalization_warnings: nonStringFields\n    },\n    pairedItem: { item: i }\n  };\n});"
      },
